title = "Reference Manual"
initial_position = 1
size = Vector2i(900, 700)
visible = false

[node name="TabContainer" type="TabContainer" parent="ManualWindow"]
offset_right = 900.0
offset_bottom = 700.0
current_tab = 0

[node name="Arithmetic" type="ScrollContainer" parent="ManualWindow/TabContainer"]
layout_mode = 2
metadata/_tab_index = 0

[node name="Content" type="RichTextLabel" parent="ManualWindow/TabContainer/Arithmetic"]
custom_minimum_size = Vector2(850, 0)
layout_mode = 2
theme_override_fonts/normal_font = ExtResource("3_xc2rq")
theme_override_font_sizes/normal_font_size = 16
bbcode_enabled = true
text = "[font_size=24][b]Arithmetic Instructions[/b][/font_size]

[code]add <op1> <op2>
sub <op1> <op2>
mul <op1> <op2>
div <op1> <op2>
cmp <op1> <op2>[/code]

[font_size=18][b]CMP Result:[/b][/font_size]
  [code]cmp = 0[/code]  if op1 = op2
  [code]cmp = -1[/code] if op1 < op2
  [code]cmp = 1[/code]  if op1 > op2"
fit_content = true

[node name="Registers" type="ScrollContainer" parent="ManualWindow/TabContainer"]
visible = false
layout_mode = 2
metadata/_tab_index = 1

[node name="Content" type="RichTextLabel" parent="ManualWindow/TabContainer/Registers"]
custom_minimum_size = Vector2(850, 0)
layout_mode = 2
theme_override_fonts/normal_font = ExtResource("3_xc2rq")
theme_override_font_sizes/normal_font_size = 16
bbcode_enabled = true
text = "[font_size=24][b]Registers[/b][/font_size]

[font_size=18][b]r0[/b][/font_size]
  Primary accumulator register (arithmetic results)

[font_size=18][b]r1[/b][/font_size]
  General-purpose register

[font_size=18][b]r2[/b][/font_size]
  General-purpose register

[font_size=18][b]cmp[/b][/font_size]
  Comparison result register:
  [code]-1[/code] (less), [code]0[/code] (equal), [code]1[/code] (greater)"
fit_content = true

[node name="Control Flow" type="ScrollContainer" parent="ManualWindow/TabContainer"]
visible = false
layout_mode = 2
metadata/_tab_index = 2

[node name="Content" type="RichTextLabel" parent="ManualWindow/TabContainer/Control Flow"]
custom_minimum_size = Vector2(850, 0)
layout_mode = 2
theme_override_fonts/normal_font = ExtResource("3_xc2rq")
theme_override_font_sizes/normal_font_size = 16
bbcode_enabled = true
text = "[font_size=24][b]Control Flow Instructions[/b][/font_size]

[code]jmp <label>[/code]
  Unconditional jump to label

[code]jeq <label>[/code]
  Jump if cmp == 0

[code]jne <label>[/code]
  Jump if cmp != 0

[code]jgt <label>[/code]
  Jump if cmp > 0

[code]jlt <label>[/code]
  Jump if cmp < 0

[code]jge <label>[/code]
  Jump if cmp >= 0

[code]jle <label>[/code]
  Jump if cmp <= 0"
fit_content = true

[node name="Instructions" type="ScrollContainer" parent="ManualWindow/TabContainer"]
visible = false
layout_mode = 2
metadata/_tab_index = 3

[node name="Content" type="RichTextLabel" parent="ManualWindow/TabContainer/Instructions"]
custom_minimum_size = Vector2(850, 0)
layout_mode = 2
theme_override_fonts/normal_font = ExtResource("3_xc2rq")
theme_override_font_sizes/normal_font_size = 16
bbcode_enabled = true
text = "[font_size=24][b]Step-Consuming Instructions[/b][/font_size]

These instructions consume one simulation step:

- [code]mov [l|r|u|d][/code] - Move in direction
- [code]rot [l|r][/code] - Rotate left/right
- [code]grb[/code] - Grab object
- [code]drp[/code] - Drop object
- [code]swt[/code] - Switch/toggle
- [code]wait[/code] - Wait one step


[font_size=24][b]Free Instructions[/b][/font_size]

These instructions execute instantly (no step cost):

[font_size=18][b]Arithmetic:[/b][/font_size]
- [code]add[/code], [code]sub[/code], [code]mul[/code], [code]div[/code], [code]cmp[/code]

[font_size=18][b]Control Flow:[/b][/font_size]
- [code]jmp[/code], [code]jeq[/code], [code]jne[/code], [code]jgt[/code]
- [code]jlt[/code], [code]jge[/code], [code]jle[/code]

[font_size=18][b]Other:[/b][/font_size]
- [code]wrt[/code] - Write to output"
fit_content = true

